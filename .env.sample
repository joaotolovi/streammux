# StreamMux
# Copy to .env and adjust before running.

# Port the HTTP server listens on
PORT=3001

# Secret key used to encrypt user passwords (AES-GCM). MUST be changed in
# production — use at least 32 random bytes.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database location. "sqlite://" prefix is optional.
DATABASE_URI=sqlite:///data/streammux.db

# Public base URL used to build manifests (set when behind a reverse proxy).
#BASE_URL=https://streammux.example.com

# Path to the ffmpeg binary (must include ffprobe in the same directory).
#FFMPEG_PATH=ffmpeg
